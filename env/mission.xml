<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<Mission xmlns="http://ProjectMalmo.microsoft.com"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://ProjectMalmo.microsoft.com Schemas/Mission.xsd">

  <About>
    <Summary>CS175 minimal grid platform mission (diamond pickup)</Summary>
  </About>

  <ServerSection>
    <ServerInitialConditions>
      <Time>
        <StartTime>6000</StartTime>
        <AllowPassageOfTime>false</AllowPassageOfTime>
      </Time>
      <Weather>clear</Weather>
    </ServerInitialConditions>

    <ServerHandlers>
      <FlatWorldGenerator generatorString="3;7,2*3,2;1;" forceReset="true"/>

      <DrawingDecorator>
        <!-- Obsidian bridge: 5 (width, X) x 10 (length, Z) at Y=4 -->
        <!-- X in [-2, 2], Z in [0, 9] -->
        <DrawCuboid x1="-2" y1="50" z1="0" x2="2" y2="50" z2="9" type="obsidian"/>

        <!-- Clear space ABOVE the bridge only (keep obsidian at y=4 intact) -->
        <DrawCuboid x1="-4" y1="5" z1="-2" x2="4" y2="5" z2="11" type="air"/>

        <!-- Lava below and around the bridge so falling off leads to lava -->
        <!-- Make the lava fill a full 16x16 chunk around the bridge at Y=2 -->
        <!-- Chunk centered on the bridge: X in [-8, 7], Z in [-8, 7] -->
        <DrawCuboid x1="-50" y1="5" z1="-50" x2="50" y2="5" z2="50" type="lava"/>

        <!-- Diamond item in the center of the last row of the bridge -->
        <DrawItem x="0" y="51" z="9" type="diamond"/>
      </DrawingDecorator>

      <!-- End the mission if agent finishes OR after time limit -->
      <ServerQuitWhenAnyAgentFinishes/>
      <ServerQuitFromTimeUp timeLimitMs="60000"/>
    </ServerHandlers>
  </ServerSection>

  <AgentSection mode="Survival">
    <Name>CS175Agent</Name>

    <AgentStart>
      <Placement x="0.5" y="51" z="0.5" yaw="0"/>
    </AgentStart>

    <AgentHandlers>
      <!-- Use continuous controls since your wrapper sends move/strafe -->
      <ContinuousMovementCommands/>

      <!-- Needed for XPos/YPos/ZPos and InventorySlot_* keys -->
      <ObservationFromFullStats/>

      <!-- +1 reward when diamond is collected (before quit) -->
      <RewardForCollectingItem>
        <Item type="diamond" reward="1"/>
      </RewardForCollectingItem>

      <!-- End mission immediately on pickup -->
      <AgentQuitFromCollectingItem>
        <Item type="diamond"/>
      </AgentQuitFromCollectingItem>

      <!-- (Optional) allow programmatic quit commands -->
      <MissionQuitCommands/>
    </AgentHandlers>
  </AgentSection>

</Mission>
